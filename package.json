    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "vite": "6.4.3"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^3.2.6"
  }
}
