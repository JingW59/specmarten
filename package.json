{
  "name": "specmarten",
  "version": "0.1.2",
  "description": "AI-first OpenSpec companion for shared human and agent coding sessions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JingW59/specmarten.git"
  },
  "bugs": {
    "url": "https://github.com/JingW59/specmarten/issues"
  },
  "homepage": "https://github.com/JingW59/specmarten#readme",
  "keywords": [
    "openspec",
    "spec-driven-development",
    "ai",
    "cli",
    "roadmap",
    "drift-detection"
  ],
  "type": "module",
  "bin": {
    "specmarten": "bin/specmarten.js"
  },
  "files": [
